def salvar_contato(agendas, nome_agenda, telefone, email,):
    agenda = {
        "agenda": nome_agenda,
        "telefone": telefone,
        "email": email,
        "favorito": False}
    agendas.append(agenda)
    print(f"Contato {nome_agenda} foi adicionado com sucesso!")
    return


def ver_contatos(agendas):
    print("\nLista de contatos:")
    for indice, agenda in enumerate(agendas, start=1):
        estrela = "⭐" if agenda["favorito"] else ""
        nome_agenda = agenda["agenda"]
        telefone = agenda["telefone"]
        email = agenda["email"]
        print(f"{indice}. {nome_agenda} {estrela}")
        print(f"   Tel: {telefone} | Email: {email}")
    return


def editar_contatos(agendas, indice_contato, novo_nome, novo_telefone, novo_email):
    indice_contato_ajustado = int(indice_contato) - 1
    if indice_contato_ajustado >= 0 and indice_contato_ajustado < len(agendas):
        agendas[indice_contato_ajustado]["agenda"] = novo_nome
        agendas[indice_contato_ajustado]["telefone"] = novo_telefone
        agendas[indice_contato_ajustado]["email"] = novo_email
        print(f"Contato {indice_contato} atualizado para {novo_nome}")
    else:
        print("Índice de contato inválido.")
    return


def deletar_contatos(agendas, indice_contato):
    indice_contato_ajustado = int(indice_contato) - 1
    if indice_contato_ajustado >= 0 and indice_contato_ajustado < len(agendas):
        agendas.pop(indice_contato_ajustado)
        print("Contato selecionado deletado")
    else:
        print("Índice de contato inválido.")
    return


def marcar_contato_como_favorito(agendas, indice_contato):
    indice_contato_favorito = int(indice_contato) - 1
    if indice_contato_favorito >= 0 and indice_contato_favorito < len(agendas):
        contato = agendas[indice_contato_favorito]
        contato["favorito"] = not contato["favorito"]
        if contato["favorito"]:
            print(f"Contato {indice_contato} marcado como favorito")
        else:
            print(f"Contato {indice_contato} removido dos favoritos")
    else:
        print("Índice de contato inválido.")
    return


def ver_favoritos(agendas):
    print("\nLista de favoritos:")
    tem_favorito = False
    for indice, agenda in enumerate(agendas, start=1):
        if agenda["favorito"]:
            nome_agenda = agenda["agenda"]
            telefone = agenda["telefone"]
            email = agenda["email"]
            print(f"{indice}. {agenda['agenda']} ⭐")
            print(f" Tel: {telefone}")
            print(f"Email: {email}")
            tem_favorito = True

    if not tem_favorito:
        print("Nenhum contato favorito ainda.")
    return


agendas = []
while True:
    print("\n Menu do Gerenciador de Lista de contatos:")
    print("1. Salvar contato")
    print("2. Ver contatos")
    print("3. Editar contato")
    print("4. Deletar contato")
    print("5. Marcar um contato como favorito")
    print("6. Ver favoritos")
    print("7. Sair")

    escolha = input("Digite a sua escolha: ")

    if escolha == "1":
        nome_agenda = input("Digite o nome do contato que deseja adicionar: ")
        telefone = input("Digite o número de telefone desejado: ")
        email = input("Digite o endereço de email desejado: ")
        salvar_contato(agendas, nome_agenda, telefone, email)

    elif escolha == "2":
        ver_contatos(agendas)

    elif escolha == "3":
        ver_contatos(agendas)
        indice_contato = input(
            "Digite o número do contato que deseja atualizar: ")
        novo_nome = input("Digite o novo nome do contato: ")
        novo_telefone = input("Digite o novo número de contatato: ")
        novo_email = input("Digite o novo email de contato: ")
        editar_contatos(agendas, indice_contato, novo_nome,
                        novo_telefone, novo_email)

    elif escolha == "4":
        ver_contatos(agendas)
        indice_contato = input(
            "Digite o número do contato que deseja deletar: ")
        deletar_contatos(agendas, indice_contato)
        ver_contatos(agendas)

    elif escolha == "5":
        ver_contatos(agendas)
        indice_contato = input(
            "Digite o número do contato que deseja favoritar: ")
        marcar_contato_como_favorito(agendas, indice_contato)

    elif escolha == "6":
        ver_favoritos(agendas)

    elif escolha == "7":
        break

print("Programa Finalizado")
